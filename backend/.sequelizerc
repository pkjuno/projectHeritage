// sequelize-cli가 설정/마이그레이션 파일을 어디서 찾을지 지정한다.
const path = require('path');

module.exports = {
  config: path.resolve('src', 'config', 'sequelize-cli.config.js'),
  'migrations-path': path.resolve('src', 'migrations'),
  // 주의: src/seeders/ 는 애플리케이션이 직접 호출하는 시드(sido.seed.js)라
  // sequelize-cli의 seeder 형식이 아니다. CLI seeder는 사용하지 않으므로 별도 경로를 둔다.
  'seeders-path': path.resolve('src', 'db-seeders'),
};
