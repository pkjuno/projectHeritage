# 서버 실행 포트
PORT=3000

# 서버 실행 환경 (development | production | test)
NODE_ENV=development

# 데이터베이스 접속 정보 (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=project_heritage
# 테스트 전용 DB (npm test 실행 시 사용, 매 테스트마다 테이블이 비워짐)
DB_NAME_TEST=project_heritage_test
DB_USER=root
DB_PASSWORD=changeme

# 프론트엔드(CORS 허용) 오리진
CLIENT_ORIGIN=http://localhost:8080

# JWT Access Token 서명 비밀 키 (운영 환경에서는 반드시 강력한 랜덤 값으로 교체)
JWT_ACCESS_SECRET=change-this-access-secret
# JWT Access Token 만료 시간
JWT_ACCESS_EXPIRES_IN=1h

# JWT Refresh Token 서명 비밀 키 (Access와 다른 값을 사용해야 안전하다)
JWT_REFRESH_SECRET=change-this-refresh-secret
# JWT Refresh Token 만료 시간
JWT_REFRESH_EXPIRES_IN=14d

# ---------------------------------------------------------------------
# 배치(스케줄러) 설정
# ---------------------------------------------------------------------
# 방문 하루 전 알림 배치 실행 주기 (cron 표현식, 기본: 매일 오전 9시)
SCHEDULE_REMINDER_CRON=0 9 * * *

# ---------------------------------------------------------------------
# 커뮤니티(게시판) 설정
# ---------------------------------------------------------------------
# 비로그인 방문자 IP를 해시할 때 쓰는 비밀 키 (조회수 중복 집계 방지용).
# IPv4는 주소 공간이 좁아 소금 없이 해시하면 원본 복원이 가능하므로 운영에서는 반드시 교체할 것.
POST_VIEW_HASH_SECRET=change-this-view-hash-secret

# ---------------------------------------------------------------------
# 파일 업로드(프로필 이미지) 설정
# ---------------------------------------------------------------------
# 업로드 파일 저장 디렉터리 (프로젝트 루트 기준)
UPLOAD_DIR=uploads
# 게시글 한 건에 첨부할 수 있는 이미지 수 (기본 5장)
UPLOAD_MAX_POST_IMAGES=5

# 프로필 이미지 최대 용량 (bytes, 기본 5MB)
UPLOAD_MAX_IMAGE_SIZE=5242880

# ---------------------------------------------------------------------
# 공공데이터 배치 적재(Importer) 설정 - npm run import:heritage / import:festival
# ---------------------------------------------------------------------

# 국가유산청 "국가유산검색" Open API. 별도 인증키 없이 사용 가능하다.
# (참고자료 3절: http://www.khs.go.kr/cha/SearchKindOpenapiList.do)
# 값이 바뀐 경우가 아니라면 수정할 필요 없음.
HERITAGE_API_LIST_URL=http://www.khs.go.kr/cha/SearchKindOpenapiList.do

# 지역축제 Open API. data.go.kr에서 "전국문화축제표준데이터"(15013104) 등을
# 활용신청(인증키 발급)한 뒤, 상세페이지에 표시되는 "요청 URL"을 그대로 붙여넣는다.
# 예) https://api.odcloud.kr/api/15013104/v1/uddi:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
FESTIVAL_API_URL=CHANGE_ME
# 위 신청 후 발급받은 서비스키(인증키, Decoding 값)
FESTIVAL_API_SERVICE_KEY=CHANGE_ME
